# Copie para o painel da Vercel (Environment Variables) — não versionar secrets.

# Chave de API do Resend (dashboard Resend > API Keys).
RESEND_API_KEY=re_xxxxxxxx

# Remetente verificado no Resend (domínio Lenext).
RESEND_FROM="Lenext <contato@newsletter.lenext.com.br>"

# Destino dos leads da LP (padrão: contato@lenext.com.br).
CONTACT_TO=contato@lenext.com.br

# Measurement ID do GA4 (Google Analytics > Admin > Fluxos de dados).
# Vazio desliga o GA4 sem quebrar nada; mesmo preenchido, só carrega
# depois do "aceitar" no banner de consentimento (LGPD).
VITE_GA4_ID=G-XXXXXXXXXX

# Pixel ID do Meta (Events Manager > Conectar dados > Meta Pixel).
# Mesma regra do GA4: vazio desliga, e só carrega após o consentimento.
VITE_META_PIXEL_ID=
